# ── 凭据 / 隐私（绝不进仓库）──────────────────────────────────
# ⚠️ 注意：.gitignore 不支持「行内注释」——`#` 之后会被当成模式的一部分。
#    所有注释都必须单独成行。
.env
.env.local
# 配置中心写 .env 前的自动备份（同样是凭据）
.env.bak
# 含真实群 openid / msg_id
last_group_msg.json
# 个人数据（备忘 / 灵感库）
memos.db
*.db
*.db-journal
# 手工备份 / 临时副本（如 memos.db.bak-20261009）
*.db.bak
*.db.bak-*
*.db.*
# 个人使用状态
moyu-recent.json
# 忽略表（含真实群内昵称 / 发送者 openid）
ignore.json
# 已发现的群（含真实群 openid）
groups.json
# 本机设置（网页「⚙ 设置」/ 机器人「设置」指令写的就是它）
settings.json

# ── 运行时产物 ───────────────────────────────────────────────
__pycache__/
*.pyc
bot.pid
bot.out.log
bot.out.log.*
botpy.log
*.log
# brain-drawer.py 的生成物（按需要手动保留）
脑内抽屉.html

# ── 私有扩展（本地自定义指令，绝不进公开仓库）────────────────
extensions/local/

# ── 依赖 / 虚拟环境 ─────────────────────────────────────────
node_modules/
venv/
env/
.venv/

# ── 系统 / 编辑器 ───────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
