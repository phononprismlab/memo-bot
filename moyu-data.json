{
  "version": 1,
  "note": "摸鱼库。手改这个文件即可增删，不用动代码。cat: relax=放松动作 / slack=摸鱼点子 / trivia=冷知识",
  "items": [
    { "id": "relax-01", "cat": "relax", "text": "站起来走 30 秒，别让腰记住椅子" },
    { "id": "relax-02", "cat": "relax", "text": "看 6 米外的东西 20 秒（20-20-20 法则，眼睛会谢你）" },
    { "id": "relax-03", "cat": "relax", "text": "4-7-8 呼吸：吸 4 秒、屏 7 秒、呼 8 秒，来 3 轮" },
    { "id": "relax-04", "cat": "relax", "text": "喝口水。不是饮料，是水" },
    { "id": "relax-05", "cat": "relax", "text": "转转头，顺时针 5 圈，逆时针 5 圈" },
    { "id": "relax-06", "cat": "relax", "text": "用力耸肩 5 秒再放下，重复 3 次" },
    { "id": "relax-07", "cat": "relax", "text": "闭眼 30 秒，什么都不想（想不出来也没关系）" },
    { "id": "relax-08", "cat": "relax", "text": "手腕转 10 圈——敲键盘的人该做" },
    { "id": "relax-09", "cat": "relax", "text": "站起来伸个懒腰，伸到打哈欠为止" },
    { "id": "relax-10", "cat": "relax", "text": "深呼吸 3 次：吸气 4 秒、呼气 6 秒" },
    { "id": "relax-11", "cat": "relax", "text": "走到窗边看看天，有没有云都行" },
    { "id": "relax-12", "cat": "relax", "text": "揉揉眼睛周围，别揉眼球" },
    { "id": "relax-13", "cat": "relax", "text": "做 10 个深蹲——真的，比咖啡管用" },
    { "id": "relax-14", "cat": "relax", "text": "把手机扣过来放 1 分钟" },
    { "id": "relax-15", "cat": "relax", "text": "用冷水洗把脸" },
    { "id": "relax-16", "cat": "relax", "text": "踮脚 20 下，让血往下走再回来" },
    { "id": "relax-17", "cat": "relax", "text": "眯眼看远处 15 秒，再睁大看近处 15 秒，来回 3 次" },
    { "id": "relax-18", "cat": "relax", "text": "把椅子调高一点，坐直——就这一下，背会舒服很多" },
    { "id": "relax-19", "cat": "relax", "text": "用拳头轻轻敲敲大腿外侧，从上到下" },
    { "id": "relax-20", "cat": "relax", "text": "双手搓热，捂在眼睛上 10 秒" },

    { "id": "slack-01", "cat": "slack", "text": "假装在看监控，其实在数鱼缸里的鱼" },
    { "id": "slack-02", "cat": "slack", "text": "把光标放到一个很长的文件里，然后发呆" },
    { "id": "slack-03", "cat": "slack", "text": "打开一个 PDF，翻到第 7 页，永远停在那里" },
    { "id": "slack-04", "cat": "slack", "text": "皱着眉头看天花板，像在思考架构" },
    { "id": "slack-05", "cat": "slack", "text": "在便签上认真写点什么——其实写的是「今天午饭吃什么」" },
    { "id": "slack-06", "cat": "slack", "text": "站起来去接水，路上多绕一圈" },
    { "id": "slack-07", "cat": "slack", "text": "打开任务管理器，看那些进程名字，猜它们是干嘛的" },
    { "id": "slack-08", "cat": "slack", "text": "给工位上的绿植说句话——它不会告状" },
    { "id": "slack-09", "cat": "slack", "text": "假装回消息，其实在翻自己的相册" },
    { "id": "slack-10", "cat": "slack", "text": "把桌面文件按大小排一遍，再按日期排回来" },
    { "id": "slack-11", "cat": "slack", "text": "打开邮箱，把所有未读标成已读——这就是今天的工作量" },
    { "id": "slack-12", "cat": "slack", "text": "去洗手间多待 3 分钟，这是正当权利" },
    { "id": "slack-13", "cat": "slack", "text": "打开终端敲一个 tree，看它跑完" },
    { "id": "slack-14", "cat": "slack", "text": "盯着进度条看它走完，然后再跑一遍" },
    { "id": "slack-15", "cat": "slack", "text": "假装接电话，走到楼道里站 5 分钟" },
    { "id": "slack-16", "cat": "slack", "text": "把鼠标 DPI 调到最高，感受一下失控" },
    { "id": "slack-17", "cat": "slack", "text": "打开一个空文档，打上标题，另存为「新建文件夹」" },
    { "id": "slack-18", "cat": "slack", "text": "数一数这屋里一共有几个插座" },
    { "id": "slack-19", "cat": "slack", "text": "用记事本把一段文字排成金字塔形状" },
    { "id": "slack-20", "cat": "slack", "text": "打开日历，数一数还有几天到周末" },
    { "id": "slack-21", "cat": "slack", "text": "把浏览器标签页一个一个关掉，再一个一个恢复" },
    { "id": "slack-22", "cat": "slack", "text": "给文件夹改个很正式的名字，比如「2026 年度战略规划」" },
    { "id": "slack-23", "cat": "slack", "text": "打开计算器，算算距离下班还有多少秒" },
    { "id": "slack-24", "cat": "slack", "text": "盯着一行代码看 1 分钟，然后不改它——你已经赢了" },
    { "id": "slack-25", "cat": "slack", "text": "把水杯从左手边挪到右手边，假装换了工作环境" },

    { "id": "trivia-01", "cat": "trivia", "text": "章鱼有三个心脏，血是蓝色的" },
    { "id": "trivia-02", "cat": "trivia", "text": "蜂蜜放几千年都不会坏" },
    { "id": "trivia-03", "cat": "trivia", "text": "人的胃酸能溶解刀片（但别试）" },
    { "id": "trivia-04", "cat": "trivia", "text": "香蕉是浆果，草莓不是" },
    { "id": "trivia-05", "cat": "trivia", "text": "一只蜗牛有 14000 多颗牙" },
    { "id": "trivia-06", "cat": "trivia", "text": "树懒憋气能憋 40 分钟" },
    { "id": "trivia-07", "cat": "trivia", "text": "打火机比火柴发明得早" },
    { "id": "trivia-08", "cat": "trivia", "text": "键盘上 F 和 J 的凸起，是给盲打定位用的" },
    { "id": "trivia-09", "cat": "trivia", "text": "有些鲨鱼能活 400 岁——比树还久" },
    { "id": "trivia-10", "cat": "trivia", "text": "一朵云平均重约 500 吨" },
    { "id": "trivia-11", "cat": "trivia", "text": "企鹅求婚送的是石头" },
    { "id": "trivia-12", "cat": "trivia", "text": "人一辈子大约眨眼 4 亿次" },
    { "id": "trivia-13", "cat": "trivia", "text": "长颈鹿的脖子只有 7 节椎骨，和你一样多" },
    { "id": "trivia-14", "cat": "trivia", "text": "月亮每年远离地球约 3.8 厘米" },
    { "id": "trivia-15", "cat": "trivia", "text": "水母没有心脏也没有大脑，但它活着" },
    { "id": "trivia-16", "cat": "trivia", "text": "一天 86400 秒，摸鱼一分钟只用了 1/1440" },
    { "id": "trivia-17", "cat": "trivia", "text": "你身体里约 30 万亿个细胞，此刻都在为你打工" },
    { "id": "trivia-18", "cat": "trivia", "text": "咖啡因不给你能量，它只是拦住了让你犯困的信号" },
    { "id": "trivia-19", "cat": "trivia", "text": "猫的呼噜声频率（25–150Hz）被认为有助于骨骼愈合" },
    { "id": "trivia-20", "cat": "trivia", "text": "你打哈欠时看到别人打哈欠，也会想打——这叫传染性哈欠" }
  ]
}
