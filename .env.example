# 复制为 .env 后填入你的真实值（.env 已被 .gitignore 忽略，不会进仓库）
# QQ 官方机器人凭据：https://q.qq.com 创建机器人后，在「开发设置」获取
# 注意：botpy 登录用的是「AppID + AppSecret(机器人密钥)」，不是 Token。
# 群聊与私聊共用同一套指令；要用私聊，还需在 QQ 开放平台「功能配置」里开启「单聊」。
QQ_BOT_APPID=你的AppID
QQ_BOT_SECRET=你的AppSecret

# 发文件时的默认目标群 openid（不填则调用时用 --group 指定）
# 私聊目标不在这里配：调用时用 `python send_file.py --user <user_openid>`
QQ_GROUP_OPENID=

# 是否使用沙箱域名（本地联调可设 true；正式留空/false）
QQ_BOT_SANDBOX=false

# 备忘触发词：群消息以此开头即记为备忘（前面可带 @机器人）
MEMO_TRIGGER=备忘

# bot 每次启动时在群里播报的一句话（留空则不播报；需群内开启「机器人主动发言」）
# 🔴 可以不改这里 —— 「配置中心」网页（python config-web.py）、或群里发
#    `设置 startup_msg <值>` 都能改，它们写 settings.json，优先级高于本文件
#    （本文件变成回退值）。
QQ_STARTUP_MSG=我上班了，开摸！

# 关机自动播报的文案（由工作区的 offwork_notify.py 读取；留空 = 不发）
# 🔴 同样可以改用配置中心网页、或 `设置 offwork_msg <值>`（键名 offwork_msg）。
OFFWORK_MSG=现在开始，我要下班了！

# ── 以下均为可选；不填则走各自的安全默认值 ───────────────────────

# 本机设置文件路径（默认 = memo-bot/settings.json，已 gitignore）。
# 配置中心网页与机器人「设置」指令写的就是它；密钥不放这里，仍留在本文件。
# MEMO_SETTINGS_FILE=C:/path/to/settings.json

# 「发文件」搜索根目录（默认 = 你的用户主目录 ~）。
# 改成任意目录可缩小检索范围，例如只搜某个项目文件夹。
# ⚠️ 不要指向含凭据 / 私密文件的目录；.ssh/.aws/.config 等已被强制排除。
# ⚠️ 主目录里常有百万级文件（AppData / 下载 / 各种缓存）—— 实测 216 万文件时
#    一次搜索要 1 分钟左右。**强烈建议指向你真正放文档的那个目录。**
# 🔴 用「配置中心」网页改最省事：里面有目录浏览器，还有个「测试」按钮会
#    当场告诉你这个目录有多少文件、扫一遍要多久。
# MEMO_SEARCH_ROOT=C:/Users/你的用户名/Documents

# 「发文件」搜索里加权的目录（默认 = memo-bot 自身目录），一般无需改。
# MEMO_WORKSPACE_ROOT=

# ── 忽略表：命中规则的群 / 私聊消息一律跳过（不收灵感、不响应）────
# 同群里有别的机器人时会互相收集对方的话，极端情况下还会形成互相响应的循环。
# 把对方的名字 / openid 记下来即可打断。
# 规则语义（命中任一即跳过）：① 消息文本含该串（忽略大小写）② 发送者 openid 完全相等。
#
# MEMO_IGNORE 是「种子」：逗号分隔，中英文逗号都认。改这里即生效，
# 且「忽略」指令**删不掉**它（防误删把循环放出来）。
# 想在群里动态增删，直接用指令：忽略 <内容> / 忽略 列表 / 忽略 删除 <内容> / 忽略 清空
# （那些规则落在 ignore.json 里，已 gitignore。）
# MEMO_IGNORE=某个机器人,some-bot

# 忽略表规则文件路径（默认 = memo-bot/ignore.json，由「忽略」指令维护）
# MEMO_IGNORE_FILE=C:/path/to/ignore.json

# 外部依赖（默认都走 PATH 上的 node；本机装在别处才需要设）：
# MEMO_NODE=C:/path/to/node.exe
# MEMO_CHROME=C:/Program Files/Google/Chrome/Application/chrome.exe
# MEMO_PLAYWRIGHT_CORE=C:/path/to/node_modules/playwright-core

# ── 私有扩展的配置（extensions/local/，不进公开仓库）──────────────
# 「查运势」的 MEMO_FORTUNE_FILE、「资源点」的 FA_ENV_ID / FA_NODE / FA_TCB 等
# 按需自行加在这里（模板见 extensions/local/README.md）。
